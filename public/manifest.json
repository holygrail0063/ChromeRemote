{
  "manifest_version": 3,
  "name": "ChromeRemote",
  "description": "Local playback controls for the active Netflix video player.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChromeRemote"
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["assets/netflix-adapter.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.netflix.com/*", "http://localhost:8787/*"],
  "permissions": ["activeTab", "storage", "tabs"]
}
