{
  "manifest_version": 3,
  "name": "ChromeRemote",
  "description": "Phone playback controls for supported Netflix and YouTube video players.",
  "version": "1.7.2",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChromeRemote"
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["assets/netflix-adapter.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*", "https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "http://localhost:8787/*"
  ],
  "permissions": ["activeTab", "storage", "tabs"]
}
