{
  "name": "chrome-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:extension && npm run build:server && npm run build:remote",
    "build:extension": "tsc --noEmit && node scripts/build-extension.mjs",
    "build:extension:production": "npm run build:extension && node scripts/verify-production-build.mjs",
    "build:railway": "npm run build:server && npm run build:remote",
    "build:server": "tsc -p server/tsconfig.json",
    "build:remote": "tsc -p remote/tsconfig.json && vite build remote --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json && tsc -p remote/tsconfig.json",
    "start": "node server/dist/server/src/server.js",
    "test": "tsc -p tsconfig.test.json && node --test .tmp/test-build/tests/*.test.js && node scripts/verify-extension-build.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
